  <!DOCTYPE html>

<html lang="ru">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Belek Auto — Автомобили из Китая</title>

  <style>

    * {

      box-sizing: border-box;

      margin: 0;

      padding: 0;

    }

    body {

      font-family: Arial, sans-serif;

      background: #0b0f0d;

      color: #ffffff;

    }

    header {

      display: flex;

      justify-content: space-between;

      align-items: center;

      padding: 25px 8%;

      border-bottom: 1px solid #26352c;

    }

    .logo {

      font-size: 25px;

      font-weight: bold;

      color: #49e58a;

    }

    nav a {

      color: #ffffff;

      text-decoration: none;

      margin-left: 20px;

    }

    .hero {

      padding: 80px 8%;

      text-align: center;

    }

    .hero h1 {

      font-size: 48px;

      margin-bottom: 20px;

    }

    .hero h1 span {

      color: #49e58a;

    }

    .hero p {

      color: #a9b5ad;

      font-size: 18px;

      margin-bottom: 30px;

    }

    .button {

      display: inline-block;

      background: #49e58a;

      color: #07110b;

      padding: 15px 25px;

      border-radius: 8px;

      text-decoration: none;

      font-weight: bold;

    }

    .catalog {

      padding: 30px 8% 80px;

    }

    .catalog h2 {

      font-size: 32px;

      margin-bottom: 30px;

    }

    .cars {

      display: grid;

      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));

      gap: 25px;

    }

    .car {

      background: #151d18;

      border: 1px solid #2a3b30;

      border-radius: 15px;

      overflow: hidden;

      padding-bottom: 20px;

    }

    .car img {

      width: 100%;

      height: 190px;

      object-fit: cover;

    }

    .car h3,

    .car p,

    .car a {

      margin-left: 20px;

      margin-right: 20px;

    }

    .car h3 {

      margin-top: 20px;

      font-size: 22px;

    }

    .car p {

      color: #a9b5ad;

      margin-top: 10px;

      margin-bottom: 15px;

    }

    .price {

      color: #49e58a !important;

      font-size: 21px;

      font-weight: bold;

    }

    footer {

      text-align: center;

      padding: 30px;

      color: #89978d;

      border-top: 1px solid #26352c;

    }

    @media (max-width: 600px) {

      .hero h1 {

        font-size: 34px;

      }

      nav {

        display: none;

      }

    }

  </style>

</head>

<body>

